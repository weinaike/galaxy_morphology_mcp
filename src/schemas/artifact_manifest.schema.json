{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galaxy-morphology-mcp/artifact_manifest/1.0",
  "title": "Artifact Manifest",
  "description": "Layer-1 input contract: explicit pointers to all fitting artifacts of one round. Generated by the fitting-artifact parser; analysis tools must not glob directories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "round_id", "lyric_file", "summary_file", "bands", "catalog"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "round_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "description": "ISO 8601 timestamp"},
    "galaxy_id": {"type": "string"},
    "lyric_file": {"type": "string", "minLength": 1},
    "summary_file": {"type": "string", "minLength": 1},
    "comparison_png": {"type": ["string", "null"]},
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "band", "science_fits", "science_hdu", "result_fits",
          "residual_hdu", "mask_hdu", "sigma_hdu", "model_hdu", "original_hdu",
          "psf_fits", "psf_hdu", "pixscale_arcsec", "fit_region"
        ],
        "properties": {
          "band": {"type": "string", "minLength": 1},
          "science_fits": {"type": "string", "minLength": 1},
          "science_hdu": {"type": "integer", "minimum": 0},
          "result_fits": {"type": "string", "minLength": 1},
          "residual_hdu": {"type": "integer", "minimum": 0},
          "mask_hdu": {"type": "integer", "minimum": 0},
          "sigma_hdu": {"type": "integer", "minimum": 0},
          "model_hdu": {"type": "integer", "minimum": 0},
          "original_hdu": {"type": "integer", "minimum": 0},
          "psf_fits": {"type": ["string", "null"]},
          "psf_hdu": {"type": ["integer", "null"], "minimum": 0},
          "pixscale_arcsec": {"type": "number", "exclusiveMinimum": 0},
          "fit_region": {
            "type": "array",
            "description": "[xmin, xmax, ymin, ymax] in pixels",
            "items": {"type": "integer", "minimum": 0},
            "minItems": 4,
            "maxItems": 4
          },
          "validation": {
            "type": "object",
            "description": "Parser-side artifact validation results for this band",
            "additionalProperties": false,
            "properties": {
              "paths_exist": {"type": ["boolean", "null"]},
              "hdu_layout_valid": {"type": ["boolean", "null"]},
              "shape_consistent": {"type": ["boolean", "null"]},
              "wcs_valid": {"type": ["boolean", "null"]},
              "unit": {"type": ["string", "null"]},
              "finite_pixel_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "available"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "format": {"type": ["string", "null"]},
        "available": {"type": "boolean"}
      }
    }
  }
}
