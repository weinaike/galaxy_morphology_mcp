{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galaxy-morphology-mcp/decision_artifact/1.1",
  "title": "Decision Artifact v1.1",
  "description": "Layer-3 decision contract with raw/resolved actions, candidate history and workflow status.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "component": {
      "enum": [
        "disk",
        "bulge",
        "edge_on_disk",
        "bar",
        "agn",
        "fourier_m1",
        "companion",
        "compact_central_source_candidate",
        "lens",
        null
      ]
    },
    "parameter_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_model_label",
        "parameter",
        "operation"
      ],
      "properties": {
        "target_model_label": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "SET_INITIAL",
            "SET_BOUNDS",
            "FIX_VALUE",
            "FREE_VALUE",
            "LINK_CENTER",
            "REMOVE_NONREQUIRED_CONSTRAINT"
          ]
        },
        "value": {},
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "reference_model_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "termination_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNAVAILABLE",
            "NOT_APPLICABLE"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rule_trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "outcome"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "SATISFIED",
              "NOT_SATISFIED",
              "NOT_APPLICABLE",
              "INCONCLUSIVE"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unmet_conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "blocking": {
            "type": "boolean"
          },
          "collector_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_new_fingerprint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type"
      ],
      "properties": {
        "action_type": {
          "enum": [
            "PROPOSE_ADD",
            "PROPOSE_REPLACE",
            "PROPOSE_REMOVE",
            "PROMOTE_SINGLE_SERSIC_TO_DISK",
            "REFIT_PARAMETERS",
            "COLLECT_EVIDENCE",
            "CONVERGED",
            "INCONCLUSIVE",
            "ACCEPT_REFIT",
            "REJECT_REFIT"
          ]
        },
        "component": {
          "$ref": "#/$defs/component"
        },
        "replace_from": {
          "$ref": "#/$defs/component"
        },
        "replace_to": {
          "$ref": "#/$defs/component"
        },
        "target_model_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "physical_identity": {
          "enum": [
            "agn",
            "stellar_nucleus",
            "unconfirmed",
            null
          ]
        },
        "resolved_state": {
          "enum": [
            "resolved",
            "unresolved",
            "inconclusive",
            null
          ]
        },
        "semantic_transition": {
          "enum": [
            "single_sersic_to_disk",
            null
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parameter_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_change"
          }
        },
        "continuation_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "next_step": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "next_transition": {
          "enum": [
            "RUN_FIT",
            "COLLECT_EVIDENCE",
            "VERIFY_BEST_ROUND",
            "REPORT_AND_HANDOFF",
            "REVIEW",
            null
          ]
        },
        "evidence_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "termination_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/termination_check"
          }
        },
        "collector_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_input_change": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_new_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action_type": {
                "enum": [
                  "PROPOSE_ADD",
                  "PROPOSE_REMOVE",
                  "PROMOTE_SINGLE_SERSIC_TO_DISK",
                  "ACCEPT_REFIT",
                  "REJECT_REFIT"
                ]
              }
            }
          },
          "then": {
            "required": [
              "component"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "PROMOTE_SINGLE_SERSIC_TO_DISK"
              }
            }
          },
          "then": {
            "required": [
              "component",
              "target_model_label",
              "semantic_transition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "PROPOSE_REMOVE"
              }
            }
          },
          "then": {
            "required": [
              "target_model_label"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "PROPOSE_REPLACE"
              }
            }
          },
          "then": {
            "required": [
              "replace_from",
              "replace_to",
              "target_model_label"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "REFIT_PARAMETERS"
              }
            }
          },
          "then": {
            "required": [
              "parameter_changes"
            ],
            "properties": {
              "parameter_changes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "COLLECT_EVIDENCE"
              }
            }
          },
          "then": {
            "required": [
              "continuation_reason",
              "next_step",
              "next_transition",
              "collector_id",
              "evidence_targets",
              "expected_new_fingerprint"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action_type": {
                "const": "CONVERGED"
              }
            }
          },
          "then": {
            "required": [
              "termination_checks"
            ],
            "properties": {
              "termination_checks": {
                "minItems": 7
              }
            }
          }
        }
      ]
    },
    "action_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/action"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "round_id",
    "state",
    "action",
    "raw_decision",
    "candidate_actions",
    "workflow_status",
    "rule_trace",
    "evidence_refs",
    "rules_version",
    "thresholds_version",
    "termination_checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "round_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string"
    },
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "thresholds_version": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "PROPOSE",
        "EVALUATE_REFIT"
      ]
    },
    "workflow_status": {
      "enum": [
        "CONTINUE",
        "CONVERGED",
        "STOPPED_NEEDS_REVIEW"
      ]
    },
    "action": {
      "$ref": "#/$defs/action_or_null"
    },
    "raw_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "action",
        "rule_trace"
      ],
      "properties": {
        "state": {
          "enum": [
            "PROPOSE",
            "EVALUATE_REFIT"
          ]
        },
        "action": {
          "$ref": "#/$defs/action_or_null"
        },
        "rule_trace": {
          "$ref": "#/$defs/rule_trace"
        }
      }
    },
    "candidate_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "priority",
          "status",
          "action"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "SELECTED",
              "DEFERRED",
              "TERMINATED",
              "INCONCLUSIVE"
            ]
          },
          "action": {
            "$ref": "#/$defs/action"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "termination_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/termination_check"
      }
    },
    "rule_trace": {
      "$ref": "#/$defs/rule_trace"
    },
    "evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_evidence",
        "vlm_evidence"
      ],
      "properties": {
        "numeric_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "vlm_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_round": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_config_checksum": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "automation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "policy_version",
        "resolution",
        "original_action_type",
        "needs_review"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "enum": [
            "trial_fit",
            "conservative_keep",
            "reject_fallback",
            "numeric_only_retry",
            "collect_evidence",
            "candidate_queue",
            "rule_terminated"
          ]
        },
        "original_action_type": {
          "type": "string",
          "minLength": 1
        },
        "resolved_rule_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    },
    "refit_evaluation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "candidate_action_type",
        "fit_converged",
        "residual_outcome",
        "parameters_physical"
      ],
      "properties": {
        "candidate_action_type": {
          "enum": [
            "PROPOSE_ADD",
            "PROPOSE_REMOVE",
            "PROPOSE_REPLACE",
            "PROMOTE_SINGLE_SERSIC_TO_DISK",
            "REFIT_PARAMETERS"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "fit_converged": {
          "enum": [
            "yes",
            "no",
            "inconclusive"
          ]
        },
        "residual_outcome": {
          "enum": [
            "improved",
            "equivalent",
            "worse",
            "inconclusive"
          ]
        },
        "parameters_physical": {
          "enum": [
            "yes",
            "no",
            "inconclusive"
          ]
        },
        "boundary_hits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "degeneracy_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bic": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "bic_simple",
            "bic_complex",
            "bic_gain",
            "comparable"
          ],
          "properties": {
            "bic_simple": {
              "type": "number"
            },
            "bic_complex": {
              "type": "number"
            },
            "bic_gain": {
              "type": "number"
            },
            "comparable": {
              "type": "boolean"
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            },
            "n_data_points": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "n_free_parameters_simple": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "n_free_parameters_complex": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "reduced_chisq": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "baseline",
            "candidate",
            "delta",
            "comparable"
          ],
          "properties": {
            "baseline": {
              "type": "number"
            },
            "candidate": {
              "type": "number"
            },
            "delta": {
              "type": "number"
            },
            "comparable": {
              "type": "boolean"
            },
            "formula": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "evidence_views": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vlm": {
          "type": "object"
        },
        "numeric_only": {
          "type": "object"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "EVALUATE_REFIT"
          }
        }
      },
      "then": {
        "required": [
          "refit_evaluation"
        ],
        "properties": {
          "refit_evaluation": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PROPOSE"
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "not": {
              "type": "object",
              "properties": {
                "action_type": {
                  "enum": [
                    "ACCEPT_REFIT",
                    "REJECT_REFIT"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_status": {
            "const": "CONVERGED"
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "type": "object",
            "properties": {
              "action_type": {
                "const": "CONVERGED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_status": {
            "const": "STOPPED_NEEDS_REVIEW"
          }
        }
      },
      "then": {
        "required": [
          "automation"
        ],
        "properties": {
          "automation": {
            "type": "object",
            "properties": {
              "needs_review": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
