{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component evalset action prelabel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "canonical_action",
    "pre_action_necessity",
    "reason_codes",
    "evidence_refs",
    "prelabel_status"
  ],
  "properties": {
    "schema_version": {
      "const": "evaluation-action-prelabel@v1"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_type"
      ],
      "properties": {
        "action_type": {
          "enum": [
            "PROPOSE_ADD",
            "PROPOSE_REMOVE",
            "PROPOSE_REPLACE",
            "PROMOTE_SINGLE_SERSIC_TO_DISK",
            "REFIT_PARAMETERS",
            "CONVERGED",
            "COMPOUND"
          ]
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "replace_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "replace_to": {
          "type": [
            "string",
            "null"
          ]
        },
        "atomic_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type"
            ],
            "properties": {
              "action_type": {
                "enum": [
                  "PROPOSE_ADD",
                  "PROPOSE_REMOVE",
                  "PROPOSE_REPLACE",
                  "PROMOTE_SINGLE_SERSIC_TO_DISK"
                ]
              },
              "component": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "replace_from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "replace_to": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "compound_reason": {
          "enum": [
            "NO_INTERMEDIATE_ROUND",
            "UNMAPPABLE_ATOMIC_CHANGE"
          ]
        }
      }
    },
    "pre_action_necessity": {
      "enum": [
        "supported",
        "unsupported",
        "unknown"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prelabel_status": {
      "const": "PRELABEL_ONLY"
    },
    "evidence_facts": {
      "type": "object"
    }
  }
}
