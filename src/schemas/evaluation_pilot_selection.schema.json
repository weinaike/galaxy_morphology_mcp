{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component evalset confirmed micro-pilot selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "inventory_run_id",
    "design_sha256",
    "adjudication_rule_version",
    "selection_policy",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "evaluation-pilot-selection@v1"
    },
    "status": {
      "enum": [
        "USER_AUTHORIZED_MICRO_PILOT",
        "USER_AUTHORIZED_PILOT",
        "USER_AUTHORIZED_FULL"
      ]
    },
    "inventory_run_id": {
      "type": "string",
      "minLength": 1
    },
    "design_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudication_rule_version": {
      "const": "component-evalset-v2"
    },
    "selection_policy": {
      "type": "string",
      "minLength": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "object_id",
          "batch",
          "rounds",
          "selection_reason",
          "coverage_tags"
        ],
        "properties": {
          "mode": {
            "enum": [
              "single_band",
              "multi_band"
            ]
          },
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "batch": {
            "type": "string",
            "minLength": 1
          },
          "rounds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "coverage_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
