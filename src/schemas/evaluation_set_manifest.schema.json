{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component evalset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "design_sha256",
    "adjudication_rule_version",
    "source_inventory_sha256",
    "sample_count",
    "object_count",
    "sample_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "evaluation-set-manifest@v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "single_band",
        "multi_band",
        "combined"
      ]
    },
    "design_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adjudication_rule_version": {
      "const": "component-evalset-v2"
    },
    "source_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "sample_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frozen_at": {
      "type": "string",
      "minLength": 1
    },
    "code_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "pool_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "by_mode": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "by_action": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "validation_report": {
      "type": "string",
      "minLength": 1
    }
  }
}
