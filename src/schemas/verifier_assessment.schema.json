{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "galaxy-morphology-mcp/verifier_assessment/1.0",
  "title": "Structured Verifier Assessment",
  "description": "Client-supplied visual and physical assessment. It is evidence, not a lock command.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dimensions", "rationale", "evidence_refs", "client", "model", "prompt_version"],
  "properties": {
    "schema_version": {"const": "verifier-assessment@v1"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation", "components", "fit", "physical", "parameters", "metrics"],
      "properties": {
        "validation": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "components": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "fit": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "physical": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "parameters": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
        "metrics": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}
      }
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "prompt_version": {"type": "string", "minLength": 1}
  }
}
